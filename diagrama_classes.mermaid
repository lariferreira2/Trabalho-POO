classDiagram
    direction TB

    class Registro {
        <<abstract>>
        -int id
        +getId() int
        +setId(int id) void
        +dados() String
        +exibirDados() void
    }

    class Pessoa {
        <<abstract>>
        -String nome
        -String cpf
        -String email
        -String telefone
        +getNome() String
        +setNome(String nome) void
        +getCpf() String
        +setCpf(String cpf) void
        +getEmail() String
        +setEmail(String email) void
        +getTelefone() String
        +setTelefone(String telefone) void
        +dados() String
    }

    class Aluno {
        -String matricula
        -String objetivo
        -int idPlano
        +getMatricula() String
        +setMatricula(String matricula) void
        +getObjetivo() String
        +setObjetivo(String objetivo) void
        +getIdPlano() int
        +setIdPlano(int idPlano) void
        +dados() String
    }

    class Professor {
        -String cref
        -String especialidade
        +getCref() String
        +setCref(String cref) void
        +getEspecialidade() String
        +setEspecialidade(String especialidade) void
        +dados() String
    }

    class ProfessorPresencial {
        -String sala
        +getSala() String
        +setSala(String sala) void
        +dados() String
    }

    class ProfessorOnline {
        -String plataforma
        +getPlataforma() String
        +setPlataforma(String plataforma) void
        +dados() String
    }

    class Plano {
        -String nome
        -int duracaoMeses
        -double valor
        +getNome() String
        +setNome(String nome) void
        +getDuracaoMeses() int
        +setDuracaoMeses(int meses) void
        +getValor() double
        +setValor(double valor) void
        +dados() String
    }

    class Exercicio {
        -String nome
        -String grupoMuscular
        -int series
        -int repeticoes
        +getNome() String
        +setNome(String nome) void
        +getGrupoMuscular() String
        +setGrupoMuscular(String grupo) void
        +getSeries() int
        +setSeries(int series) void
        +getRepeticoes() int
        +setRepeticoes(int repeticoes) void
        +dados() String
    }

    class Treino {
        -String nome
        -int idAluno
        -int idProfessor
        -ArrayList~Integer~ idsExercicios
        +getNome() String
        +setNome(String nome) void
        +getIdAluno() int
        +setIdAluno(int id) void
        +getIdProfessor() int
        +setIdProfessor(int id) void
        +getIdsExercicios() ArrayList~Integer~
        +adicionarExercicio(int id) void
        +dados() String
    }

    class Avaliacao {
        -int idAluno
        -String data
        -double peso
        -double altura
        -String observacoes
        +getIdAluno() int
        +setIdAluno(int id) void
        +getData() String
        +setData(String data) void
        +getPeso() double
        +setPeso(double peso) void
        +getAltura() double
        +setAltura(double altura) void
        +getObservacoes() String
        +setObservacoes(String obs) void
        +dados() String
    }

    class Pagamento {
        -int idAluno
        -int idPlano
        -String data
        -double valor
        -String formaPagamento
        -String status
        +getIdAluno() int
        +setIdAluno(int id) void
        +getIdPlano() int
        +setIdPlano(int id) void
        +getData() String
        +setData(String data) void
        +getValor() double
        +setValor(double valor) void
        +getFormaPagamento() String
        +setFormaPagamento(String forma) void
        +getStatus() String
        +setStatus(String status) void
        +dados() String
    }

    class Repositorio~T extends Registro~ {
        -ArrayList~T~ itens
        +inserir(T item) boolean
        +listar() ArrayList~T~
        +buscar(int id) T
        +buscar(String texto) ArrayList~T~
        +atualizar(int id, T novo) boolean
        +remover(int id) boolean
        +estaVazio() boolean
    }

    class estrutura {
        -Scanner scanner
        -Repositorio~Aluno~ alunos
        -Repositorio~Professor~ professores
        -Repositorio~Plano~ planos
        -Repositorio~Exercicio~ exercicios
        -Repositorio~Treino~ treinos
        -Repositorio~Avaliacao~ avaliacoes
        -Repositorio~Pagamento~ pagamentos
        +main(String[] args) void
        -cadastrarAluno() void
        -cadastrarProfessor() void
        -cadastrarPlano() void
        -cadastrarExercicio() void
        -cadastrarTreino() void
        -cadastrarAvaliacao() void
        -cadastrarPagamento() void
        -listarTipo() void
        -buscarId() void
        -buscarTexto() void
        -atualizar() void
        -remover() void
    }

    Registro <|-- Pessoa
    Registro <|-- Plano
    Registro <|-- Exercicio
    Registro <|-- Treino
    Registro <|-- Avaliacao
    Registro <|-- Pagamento
    Pessoa <|-- Aluno
    Pessoa <|-- Professor
    Professor <|-- ProfessorPresencial
    Professor <|-- ProfessorOnline

    Aluno "*" --> "0..1" Plano : idPlano
    Pagamento "*" --> "1" Aluno : idAluno
    Pagamento "*" --> "1" Plano : idPlano
    Treino "*" --> "1" Aluno : idAluno
    Treino "*" --> "1" Professor : idProfessor
    Treino "*" --> "*" Exercicio : idsExercicios
    Avaliacao "*" --> "1" Aluno : idAluno

    Repositorio ..> Registro : T extends
    estrutura --> "7" Repositorio : gerencia

    note for Registro "ABSTRAÇÃO: Registro e Pessoa são abstratas e reúnem o que é comum (id, dados pessoais)."
    note for Pessoa "ENCAPSULAMENTO: atributos privados (-) com acesso por getters e setters públicos."
    note for Professor "HERANÇA: Aluno e Professor herdam de Pessoa; Presencial e Online herdam de Professor; todas herdam de Registro."
    note for ProfessorOnline "POLIMORFISMO: dados() é sobrescrito em cada subclasse e exibirDados() chama a versão do objeto."
